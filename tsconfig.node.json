{
  "compilerOptions": {
    "baseUrl": "./",
    "paths": {
      "@/*": ["./src/*"]
    },
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    // "module": "CommonJS", // 更改为 CommonJS
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    // "moduleResolution": "Node", // 更改为 Node
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    // "noEmit": false, // 更改为 false

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["vite.config.mts","./src/**/*.ts", "src/assets/images/sprite.js" ], 
  "exclude": ["node_modules"]
}
